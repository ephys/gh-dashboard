{
  "name": "@ephys/gh-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.1.1",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "npm run format:eslint && npm run format:prettier",
    "format:eslint": "npm run test:eslint -- --fix",
    "format:prettier": "prettier . --write",
    "preview": "vite preview",
    "test": "concurrently \"npm:test:*\"",
    "test:eslint": "eslint . --report-unused-disable-directives",
    "test:prettier": "prettier . --check",
    "test:typing": "tsc --noEmit"
  },
  "dependencies": {
    "@primer/css": "^22.1.0",
    "@primer/octicons-react": "^19.22.0",
    "@primer/primitives": "^11.5.1",
    "@primer/react": "^38.14.0",
    "@sequelize/utils": "^7.0.0-alpha.48",
    "clsx": "^2.1.1",
    "graphql": "^16.13.1",
    "notistack": "^3.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "urql": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ephys/eslint-config-typescript": "^21.0.1",
    "@graphql-codegen/cli": "^6.1.3",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@parcel/watcher": "^2.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.97.3",
    "styled-components": "^6.3.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
